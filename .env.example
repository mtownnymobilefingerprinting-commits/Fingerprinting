# Copy to .env.local for development. In Vercel, set these under Project → Settings → Environment Variables.
# Use Stripe TEST keys for Preview/Development. Never prefix secrets with NEXT_PUBLIC_.

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint for https://<your-domain>/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.processing, payment_intent.payment_failed, payment_intent.canceled, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (Project Settings → API). The service-role key is server-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ byte secret used to sign private scheduling links, e.g. `openssl rand -base64 32`.
# Changing it invalidates links already emailed to customers.
ORDER_TOKEN_SECRET=

# The Calendly event customers book after paying. Kept server-side so it is not shown on public pages.
CALENDLY_SCHEDULING_URL=https://calendly.com/mtownnymobilefingerprinting/30min
# Calendly personal access token (Integrations & apps → API and webhooks). Scopes:
# users:read, event_types:read, scheduling_links:write, scheduled_events:read.
# Enables single-use booking links and server-side booking verification (works on the Free plan).
CALENDLY_API_TOKEN=
# Protects /api/calendly/sweep (the every-5-minutes unpaid-booking check). Random 32+ bytes.
CRON_SECRET=
# "true" = cancel bookings of the paid event type that have no paid order (Calendly emails the
# invitee to pay first). Anything else = report only. Needs the scheduled_events:write scope.
# Only enable once CALENDLY_SCHEDULING_URL is a dedicated, secret event used for paid online bookings.
CALENDLY_AUTO_CANCEL=false
# Optional: skip the lookup by setting the event type URI directly.
# CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/...

# Email for "pick your time" links (optional but strongly recommended; without it customers rely on the return page).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional: BCC the owner on every schedule-link email.
OWNER_NOTIFICATION_EMAIL=
